// 1. TM1637 하위 통신 함수 (Bit-banging)
// ==========================================

void tm1637_start(void) {
	// CLK가 High인 상태에서 DIO를 Low로 내리면 Start 조건
	DDRD |= (1 << DIO_PIN); // DIO 출력 모드 (0V)
